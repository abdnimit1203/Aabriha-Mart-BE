PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/aabriha-mart

# Firebase Admin SDK (for verifying customer ID tokens issued by the frontend's Firebase Auth)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Stripe (test mode keys for now)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ImageKit (product image hosting/optimization) — private key stays server-side only
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
