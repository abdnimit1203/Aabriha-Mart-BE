PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/Aabriha-mart

# Firebase Admin SDK (for verifying customer ID tokens issued by the frontend's Firebase Auth)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Canonical frontend origin for links built server-side (e.g. the Telegram
# "View Order" button below) — set this to the real Vercel URL in
# production. Falls back to the first CORS_ORIGINS entry if unset.
FRONTEND_URL=http://localhost:3000

# Stripe (test mode keys for now)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ImageKit (product image hosting/optimization) — private key stays server-side only
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Telegram admin alerts (optional — feature stays off if unset). Create a bot
# via @BotFather to get this token. The recipient chat ID is NOT set here —
# it's configured by the Super Admin from /admin/settings instead.
TELEGRAM_BOT_TOKEN=
